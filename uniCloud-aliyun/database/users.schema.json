{
  "bsonType": "object",
  "required": ["name"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "description": "记录ID，系统自动生成"
    },
    "name": {
      "bsonType": "string",
      "label": "姓名",
      "description": "用户姓名",
      "maxLength": 20
    },
    "age": {
      "bsonType": "int",
      "label": "年龄",
      "description": "用户年龄",
      "minimum": 0,
      "maximum": 150,
      "defaultValue": 65
    },
    "avatar": {
      "bsonType": "string",
      "label": "头像",
      "description": "头像图片路径"
    },
    "health_notes": {
      "bsonType": "string",
      "label": "健康备注",
      "description": "用户健康状况备注",
      "maxLength": 500
    },
    "created_at": {
      "bsonType": "date",
      "label": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updated_at": {
      "bsonType": "date",
      "label": "更新时间"
    }
  }
}
